# Copy this file to ".env" in the backend/ folder (same folder as this file)
# and fill in the values you need. See README's "Deploying to Vercel" section
# for how to obtain DATABASE_URL / DATABASE_URL_UNPOOLED from the Neon
# Postgres integration.

# --- Database (required for anything beyond a quick local smoke-test) -----
# Pooled connection string (via PgBouncer) -- what the running app uses for
# normal request-time queries. On Vercel + the Neon integration this is
# injected automatically; for local dev, run `vercel env pull .env.local`
# from the backend/ folder, or copy it from the Neon console.
DATABASE_URL=

# Direct/unpooled connection string -- used only by app/seed.py (schema
# creation + bulk inserts behave better outside a transaction-mode pooler).
# Falls back to DATABASE_URL above if left blank.
DATABASE_URL_UNPOOLED=

# Comma-separated list of frontend origins allowed to call this API.
# Defaults to the local Vite dev server if left unset.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Secret used to sign JWT access tokens -- set this to a long random string
# in any real deployment (the default below is fine for local dev only).
SECRET_KEY=landguard-dev-secret-change-in-production

# --- LandBot AI (optional real-LLM upgrade) --------------------------------
# Nothing below is required for the app to run -- with no GROQ_API_KEY set,
# LandBot AI automatically uses its offline rule-based mode (app/chatbot.py)
# instead.

# Get a free key at https://console.groq.com/keys
GROQ_API_KEY=

# Which Groq-hosted model LandBot AI uses. Defaults to openai/gpt-oss-120b.
# Other options include openai/gpt-oss-20b (smaller/faster/cheaper) or a
# Qwen model (check console.groq.com/docs/models for the current model id).
GROQ_MODEL=openai/gpt-oss-120b

# Optional, gpt-oss models only: low / medium / high. Leave blank to use the
# model's default.
GROQ_REASONING_EFFORT=

# Set to "false" to force the offline rule-based chatbot even if a Groq key
# is present.
LLM_CHATBOT_ENABLED=true
